# ── 驗證用的簽章密鑰（HS256）─────────────────────────────
# 本機開發：複製此檔為 .env.local，並填入一組夠長的隨機字串。
# 產生方式（擇一）：
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 部署到 Vercel：在 Project → Settings → Environment Variables
# 新增同名變數 AUTH_SECRET（Production / Preview / Development 都建議設）。
AUTH_SECRET=please-change-me-to-a-long-random-string

# ── 會員帳號資料庫（標準 Postgres 連線字串）─────────────────
# 不綁定任何特定供應商，換供應商只需換這一組字串，格式固定為：
#   postgres://<user>:<password>@<host>:<port>/<database>?sslmode=require
#
# 可自行選擇（擇一，皆有免費方案）：
#   - Neon        https://neon.tech
#   - Supabase     https://supabase.com
#   - Railway      https://railway.app
#   - 本機 Docker   docker compose up -d（見 README「本機 Postgres（Docker）」，
#                   對應連線字串是 postgres://postgres:postgres@localhost:55432/postgres）
#
# 部署到 Vercel：在 Project → Settings → Environment Variables 新增同名變數
# DATABASE_URL（Production / Preview / Development 都建議設）。
# 資料表會在第一次登入/註冊請求時自動建立，不需要額外跑 migration。
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
